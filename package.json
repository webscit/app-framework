{
  "name": "app-framework",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev:simple": "npm run dev -w @app-framework/simple-example",
    "dev:reachy-mini": "npm run dev -w @app-framework/reachy-mini-example",
    "dev:drone": "npm run dev -w @app-framework/drone-example",
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write \"{e2e,examples,packages}/**/*{.ts,.tsx,.js,.jsx,.css,.json}\"",
    "format:check": "prettier --check \"{e2e,examples,packages}/**/*{.ts,.tsx,.js,.jsx,.css,.json}\"",
    "lint": "eslint packages examples",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.55.0",
    "@vitest/browser": "^4.1.5",
    "@vitest/browser-playwright": "^4.1.5",
    "eslint": "^9",
    "prettier": "^3.9.0",
    "typescript": "^5",
    "typescript-eslint": "^8.58.1",
    "vite": "^6.3.0",
    "vitest": "^4.1.5",
    "vitest-browser-react": "^2.2.0"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-darwin-arm64": "^4.3.0"
  }
}